{
  "name": "@arcable/extension",
  "version": "0.157.0",
  "description": "Arcable Chrome & Firefox Extension built with React, TypeScript and Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node build.mjs all",
    "build:chrome": "node build.mjs chrome",
    "build:firefox": "node build.mjs firefox",
    "build:dev": "node build.mjs all --dev",
    "build:dev:chrome": "node build.mjs chrome --dev",
    "build:dev:firefox": "node build.mjs firefox --dev",
    "lint:firefox": "npx web-ext lint --source-dir dist/firefox",
    "package:firefox": "npx web-ext build --source-dir dist/firefox --artifacts-dir dist/artifacts --overwrite-dest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arcable/shared": "*",
    "@mozilla/readability": "^0.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/turndown": "^5.0.6",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  }
}
