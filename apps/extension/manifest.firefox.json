{
  "manifest_version": 3,
  "name": "Arcable",
  "version": "0.108.0",
  "description": "Arcable - Unified browser workspace and intelligence extension with Raindrop.io sync",
  "browser_specific_settings": {
    "gecko": {
      "id": "arcable@extension.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "identity",
    "alarms",
    "scripting",
    "contextMenus"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.raindrop.io/*",
    "https://raindrop.io/*",
    "https://oh-auth.vercel.app/*",
    "https://arcable.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.arcable.dev/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/*",
        "src/libs/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Arcable"
  },
  "sidebar_action": {
    "default_panel": "sidepanel/index.html",
    "default_title": "Arcable Sidepanel",
    "open_at_install": true
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://oh-auth.vercel.app/*",
        "https://arcable.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.arcable.dev/*"
      ],
      "js": [
        "oauth-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
