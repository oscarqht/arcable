{
  "manifest_version": 3,
  "name": "Arcable",
  "version": "0.53.0",
  "description": "Arcable - Unified browser workspace and intelligence extension with Raindrop.io sync",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "identity",
    "sidePanel",
    "alarms",
    "scripting",
    "userScripts",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://api.raindrop.io/*",
    "https://raindrop.io/*",
    "https://oh-auth.vercel.app/*",
    "https://arcable.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.arcable.dev/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/*",
        "src/libs/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://oh-auth.vercel.app/*",
      "https://arcable.vercel.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.arcable.dev/*"
    ]
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Arcable"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://oh-auth.vercel.app/*",
        "https://arcable.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.arcable.dev/*"
      ],
      "js": [
        "oauth-bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
