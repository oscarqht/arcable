{
  "manifest_version": 3,
  "name": "Arcable",
  "version": "0.1.0",
  "description": "Arcable - Unified browser workspace and intelligence extension with Raindrop.io sync",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://api.raindrop.io/*",
    "https://raindrop.io/*",
    "https://oh-auth.vercel.app/*",
    "http://localhost:3000/*",
    "https://*.arcable.dev/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://oh-auth.vercel.app/*",
      "http://localhost:3000/*",
      "https://*.arcable.dev/*"
    ]
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Arcable"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://oh-auth.vercel.app/*",
        "http://localhost:3000/*",
        "https://*.arcable.dev/*"
      ],
      "js": ["oauth-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
