{
  "name": "arcable-monorepo",
  "version": "0.182.0",
  "private": true,
  "description": "Arcable monorepo containing Chrome/Firefox extension, Next.js webapp, and shared libraries.",
  "scripts": {
    "dev": "pnpm --filter @arcable/web run dev",
    "dev:web": "pnpm --filter @arcable/web run dev",
    "dev:extension": "pnpm --filter @arcable/extension run dev",
    "build": "pnpm run build:shared && pnpm run build:web && pnpm run build:extension",
    "build:shared": "pnpm --filter @arcable/shared run build",
    "build:web": "pnpm --filter @arcable/web run build",
    "build:extension": "pnpm --filter @arcable/extension run build",
    "build:extension:chrome": "pnpm --filter @arcable/extension run build:chrome",
    "build:extension:firefox": "pnpm --filter @arcable/extension run build:firefox",
    "build:extension:dev": "pnpm --filter @arcable/extension run build:dev",
    "build:extension:dev:chrome": "pnpm --filter @arcable/extension run build:dev:chrome",
    "build:extension:dev:firefox": "pnpm --filter @arcable/extension run build:dev:firefox",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "clean": "pnpm -r --if-present run clean",
    "version:bump:minor": "node scripts/bump-version.mjs"
  },
  "keywords": [
    "arcable",
    "monorepo",
    "chrome-extension",
    "firefox-extension",
    "nextjs",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.14.0"
}
